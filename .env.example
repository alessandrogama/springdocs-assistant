# ==========================================
# SpringDocs Assistant - Environment Config
# ==========================================

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Ollama Local LLM Service
OLLAMA_URL=http://localhost:11434

# Collection & Documentation Version
COLLECTION_NAME=spring_docs_v3_4
SPRING_VERSION=3.4

# Embedding Model Configuration
# Options:
# - BAAI/bge-small-en-v1.5 (default lightweight, dim: 384)
# - intfloat/multilingual-e5-small (multilingual lightweight, dim: 384)
# - BAAI/bge-m3 (dense/sparse hybrid powerhouse, dim: 1024)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# LLM Generation Configuration
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60.0

# Retrieval Hyperparameters
TOP_K=5
SCORE_THRESHOLD=0.35
RERANK_ENABLED=false

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
